# Copie para .env.local (dev) e cadastre na Vercel (Settings → Environment Variables).
# Nunca versione o .env.local. Variáveis da Vercel só valem depois de um redeploy.

# --- Página (públicas, vão para o navegador) ---
NEXT_PUBLIC_SITE_URL=                 # domínio final, ex.: https://www.dominio.com.br (host que NÃO redireciona)
NEXT_PUBLIC_GTM_ID=                   # GTM-XXXXXXX (GA4, Google Ads e Meta Pixel ficam DENTRO do GTM)
NEXT_PUBLIC_GA4_ID=                   # G-XXXXXXXXXX (referência; usado para gerar o JSON do GTM)
NEXT_PUBLIC_META_PIXEL_ID=            # quando houver campanha no Meta (configurar no GTM)

# --- Banco do /dashboard (projeto Supabase compartilhado da M|P; tabelas joaosalgado_*) ---
SUPABASE_URL=https://khipnjfbxjgvmjvyxero.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # secreta; nunca no front

# --- Login do /dashboard ---
DASHBOARD_PASSWORD=                   # mín. 8 caracteres
DASHBOARD_SECRET=                     # string aleatória longa (mín. 16) para assinar o token

# --- Google Ads (só leitura). Sem as 5 primeiras, a seção mostra "conexão pendente" ---
GOOGLE_ADS_CUSTOMER_ID=               # conta do CLIENTE (10 dígitos), não a da M|P nem a MCC
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=603-989-2603   # MCC pela qual a conta é acessada
GOOGLE_ADS_API_VERSION=               # opcional; padrão v25

# --- GA4 (só leitura, Data API) ---
GA4_PROPERTY_ID=                      # ID numérico da propriedade (não o G-XXXX)
GOOGLE_SERVICE_ACCOUNT_JSON=          # JSON da conta de serviço (Leitor na propriedade); secreto
