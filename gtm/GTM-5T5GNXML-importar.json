          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n  // Meta Pixel: Lead no clique de WhatsApp. O pixel base (PageView) já está no contêiner;\n  // o guard evita erro se o visitante recusou cookies e o fbq não carregou.\n  (function () {\n    if (typeof window.fbq !== 'function') return;\n    window.fbq('track', 'Lead', {\n      content_name: {{dlv - cta_id}} || 'whatsapp',\n      content_category: 'facetas',\n      utm_source: {{dlv - utm_source}} || '',\n      utm_campaign: {{dlv - utm_campaign}} || ''\n    });\n  })();\n</script>"
